{
  "name": "wealth_health_hrnet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A React-based HR management application for Wealth Health, focusing on employee record management.",
  "keywords": [
    "react",
    "typescript",
    "hr",
    "employee management",
    "wealth health",
    "hrnet"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "docs": "typedoc --options typedoc.json",
    "test": "vitest --config ./vitest.config.ts",
    "test:playwright": "npx playwright test",
    "test:unit": "vitest"
  },
  "dependencies": {
    "@ionutpuenaru/employee_table": "^1.1.12",
    "@reduxjs/toolkit": "^2.2.6",
    "@testing-library/dom": "^10.4.0",
    "ajv": "^8.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.25.1",
    "redux-persist": "^6.0.0",
    "sass": "^1.77.8",
    "tough-cookie": "^4.1.4",
    "whatwg-url": "^14.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.1",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.5.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-redux": "^7.1.33",
    "@types/react-router-dom": "^5.3.3",
    "@types/testing-library__react-hooks": "^3.4.1",
    "@types/testing-library__user-event": "^4.1.1",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "jsdom": "^25.0.0",
    "typedoc": "^0.26.6",
    "typescript": "^5.2.2",
    "vite": "^5.3.4",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^2.0.5"
